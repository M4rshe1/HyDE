{
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "margin-top": 3,
    "exclusive": true,
    "output": [
        "*"
    ],
    "passthrough": false,
    "height": 34,
    "margin-left": 5,
    "margin-right": 5,
    "margin-bottom": 0,
    "group/left1": {
        "orientation": "inherit",
        "modules": [
            "memory",
            "cpu",
            "custom/gpuinfo",
        ]
    },
    "group/left2": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces"
        ]
    },
    "group/left3": {
        "orientation": "inherit",
        "modules": [
            "mpris"
        ]
    },
    "modules-left": [
        "group/left1",
        "group/left2",
        "group/left3",
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "group/right1",
        "group/right2",
        "group/right3",
        "group/right4",
        "group/right5"
    ],
    "group/right1": {
        "orientation": "inherit",
        "modules": [
            "tray"
        ]
    },
    "group/right2": {
        "orientation": "inherit",
        "modules": [
            "pulseaudio#output",
            "pulseaudio#input",
            "network",
        ]
    },
    "group/right3": {
        "orientation": "inherit",
        "modules": [
            "clock",
            "custom/swaync",
        ]
    },
    "group/right4": {
        "orientation": "inherit",
        "modules": [
            "custom/hyde-menu",
        ]
    },
    "group/right5": {
        "orientation": "inherit",
        "modules": [
            "custom/power",
        ]
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "11": "十一",
            "12": "十二",
            "13": "十三",
            "14": "十四",
            "15": "十五",
            "16": "十六",
            "17": "十七",
            "18": "十八",
            "19": "十九",
            "20": "二十",
        },
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5,
                6
            ]
        }
    },
    "hyprland/window": {
        "format": "{class}",
        "max-length": 85,
        "rewrite": {
            " - ": "", // if no window is focused, a single dash is displayed, this removes it
            "(.*?) - Chromium - chromium": "   $1 ",
            "app.zen_browser.zen": "Zen",
            "(.*chrome)...(.*)": "   $1 ",
            "(.*) - Obsidian - .* - obsidian": "   $1 ",
            "(.*nvim)...(.*)": "   $2 ",
            "(.*code) - (.*)": " 󰨞  $1 ",
            "^.*btop( .*|$)": " 󰧨 BTOP $1 ",
            "^.*cmatrix( .*|$)": " 󰘨 MATRIX $1 ",
            "(.*) - Spotify": "  $1 ",
            "(.*) - com.mitchellh.ghostty": " 󰊠 $1 ",
            "(.*) - Alacritty": "   $1 ",
            "(.*) - BeeperTexts": " 󰻞  $1 ",
            "(.*Discord)...(.*).. (.*)": "   $2 ",
            "(.*) - org.gnome.Nautilus": " 󰣆  $1 ",
            "(.*) - fish": "   [$1] ",
            "(.*Steam)...(.*)": "   $1",
            "(.*imv)...(.*).. (.*)": "   $2",
            "(.*) - com.obsproject.Studio": "  $1 "
        }
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
}