{
  "reload_style_on_change": true,
  "include": [
    "$XDG_CONFIG_HOME/waybar/modules/*json*",
    "$XDG_CONFIG_HOME/waybar/includes/includes.json",
  ],
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "margin-top": 0,
  "exclusive": true,
  "output": ["*"],
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 34,
  "margin-left": 10,
  "margin-right": 10,
  "margin-bottom": 0,
  "group/left1": {
    "orientation": "inherit",
    "modules": ["memory", "custom/cpuinfo", "custom/gpuinfo"],
  },
  "group/left2": {
    "orientation": "inherit",
    "modules": ["hyprland/workspaces"],
  },
  "group/left3": {
    "orientation": "inherit",
    "modules": ["mpris"],
  },
  "modules-left": ["group/left1", "custom/divider", "group/left2", "custom/divider", "group/left3"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "group/right1",
    "custom/divider",
    "group/right2",
    "custom/divider",
    "group/right3",
    "custom/divider",
    "group/right4",
    "custom/divider",
    "group/right5",
  ],
  "group/right1": {
    "orientation": "inherit",
    "modules": ["tray"],
  },
  "group/right2": {
    "orientation": "inherit",
    "modules": ["pulseaudio", "pulseaudio#microphone"],
  },
  "group/right3": {
    "orientation": "inherit",
    "modules": ["network", "custom/swaync", "clock"],
  },
  "group/right4": {
    "orientation": "inherit",
    "modules": ["custom/hyde-menu"],
  },
  "group/right5": {
    "orientation": "inherit",
    "modules": ["custom/power"],
  },
  "custom/hyde-menu": {
    "format": "menu",
  },
  "custom/divider": {
    "format": " ",
    "tooltip": false,
  },
  "clock": {
    "format": "<span foreground='#6e6a86'>clk</span> {:%H:%M:%S}",
    "format-alt": "<span foreground='#6e6a86'>date</span> {:%d/%m/%Y}",
  },
  "pulseaudio": {
    "format": "<span foreground='#6e6a86'>out</span> {volume}%",
  },
  "pulseaudio#microphone": {
    "format": "<span foreground='#6e6a86'>mic</span> {source_volume}%",
  },
  "network": {
    "format-ethernet": "<span foreground='#6e6a86'>eth</span> on",
    "format": "<span foreground='#6e6a86'>eth</span> <span foreground='#9ccfd8'>{bandwidthDownBytes}</span> <span foreground='#c4a7e7'>{bandwidthUpBytes}</span>",
    "format-alt": "<span foreground='#6e6a86'>eth</span> <span foreground='#9ccfd8'>{bandwidthDownBytes}</span> <span foreground='#c4a7e7'>{bandwidthUpBytes}</span>",
  },
  "custom/swaync": {
    "format": "<span foreground='#6e6a86'>{icon}</span> {0}",
    "format-icons": {
      "none": "ntf",
      "notification": "ntf",
      "inhibited-none": "ntf",
      "inhibited-notification": "ntf",
      "email-notification": "ntf",
      "chat-notification": "ntf",
      "warning-notification": "war",
      "error-notification": "err",
      "network-notification": "net",
      "battery-notification": "bat",
      "update-notification": "upd",
      "music-notification": "mus",
      "volume-notification": "vol",
      "dnd": "dnd",
      "dnd-none": "dnd",
      "dnd-notification": "dnd",
      "dnd-inhibited-none": "dnd",
      "dnd-inhibited-notification": "dnd",
    },
  },
  "memory": {
    "format": "<span foreground='#6e6a86'>mem</span> {used:0.1f}GB",
    "format-m": "<span foreground='#6e6a86'>mem</span> {used:0.1f}GB",
    "format-h": "<span foreground='#6e6a86'>mem</span> {used:0.1f}GB",
    "format-c": "<span foreground='#6e6a86'>mem</span> {used:0.1f}GB",
    "format-alt": "<span foreground='#6e6a86'>mem</span> {percentage}%",
    "tooltip": true,
    "max-length": 15,
  },
  "cpu": {
    "format": "<span foreground='#6e6a86'>cpu</span> {usage}",
    "format-alt": "<span foreground='#6e6a86'>cpu</span> {icon0}{icon1}{icon2}{icon3}",
  },
  "custom/cpuinfo": {
    "exec": "hyde-shell app -t scope cpuinfo.sh",
    "return-type": "json",
    "format": "<span foreground='#6e6a86'>cpu</span> {0}",
    "interval": 5,
    "signal": 22,
    "tooltip": true,
    "on-click": "hyde-shell cpuinfo.sh --cycle-metric; pkill -RTMIN+22 waybar",
  },
  "custom/gpuinfo": {
    "exec": "hyde-shell app -t scope gpuinfo.sh --use nvidia",
    "return-type": "json",
    "format": "<span foreground='#6e6a86'>gpu</span> {0}",
    "interval": 5,
    "signal": 21,
    "tooltip": true,
    "on-click": "hyde-shell gpuinfo.sh --cycle-metric; pkill -RTMIN+21 waybar",
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "11": "十一",
      "12": "十二",
      "13": "十三",
      "14": "十四",
      "15": "十五",
      "16": "十六",
      "17": "十七",
      "18": "十八",
      "19": "十九",
      "20": "二十",
    },
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6],
    },
  },
  "hyprland/window": {
    "format": "{class}",
    "max-length": 85,
    "rewrite": {
      " - ": "",
      "(.*?) - Chromium - chromium": "   $1 ",
      "app.zen_browser.zen": "Zen",
      "(.*chrome)...(.*)": "   $1 ",
      "(.*) - Obsidian - .* - obsidian": "   $1 ",
      "(.*nvim)...(.*)": "   $2 ",
      "(.*code) - (.*)": " 󰨞  $1 ",
      "^.*btop( .*|$)": " 󰧨 BTOP $1 ",
      "^.*cmatrix( .*|$)": " 󰘨 MATRIX $1 ",
      "(.*) - Spotify": "  $1 ",
      "(.*) - com.mitchellh.ghostty": " 󰊠 $1 ",
      "(.*) - Alacritty": "   $1 ",
      "(.*) - BeeperTexts": " 󰻞  $1 ",
      "(.*Discord)...(.*).. (.*)": "   $2 ",
      "(.*) - org.gnome.Nautilus": " 󰣆  $1 ",
      "(.*) - fish": "   [$1] ",
      "(.*Steam)...(.*)": "   $1",
      "(.*imv)...(.*).. (.*)": "   $2",
      "(.*) - com.obsproject.Studio": "  $1 ",
    },
  },
  "tray": {
    "icon-size": 13,
    "spacing": 6,
  },
}
